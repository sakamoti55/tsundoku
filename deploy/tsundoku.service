[Unit]
Description=Tsundoku Flask application
After=network.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/tsundoku
Environment="PATH=/home/pi/tsundoku/.venv/bin"
Environment="PYTHONUNBUFFERED=1"
ExecStart=/home/pi/tsundoku/.venv/bin/gunicorn --workers 1 --threads 2 --bind 127.0.0.1:8000 --access-logfile - app:app
Restart=on-failure
RestartSec=5
UMask=0077
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
